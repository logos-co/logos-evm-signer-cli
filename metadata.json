{
  "name": "evm_signer_cli",
  "version": "0.1.0",
  "description": "Headless approver for keystore_module: shows what a module asked to sign, in the keystore's own words, over `logosctl watch`, and takes the decision over `logosctl call`.",
  "author": "Logos Core Team",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "wallet",
  "main": "evm_signer_cli_plugin",
  "dependencies": [
    { "name": "keystore_module", "version": "~0.1.0" }
  ],
  "optional_dependencies": [
    { "name": "token_list_module", "version": "~0.1.0" }
  ],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "EvmSignerCliModule", "source": "src/glue.rs" }
  },
  "nix": {
    "external_libraries": [],
    "packages": { "build": [], "runtime": [] },
    "cmake": { "find_packages": [], "extra_include_dirs": [] }
  }
}
